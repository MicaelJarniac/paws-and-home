{
  "name": "paws-and-home",
  "version": "1.0.0",
  "description": "A pet adoption website built with Node.js, Express, EJS, and custom CSS as a college assignment.",
  "homepage": "https://github.com/MicaelJarniac/paws-and-home#readme",
  "bugs": {
    "url": "https://github.com/MicaelJarniac/paws-and-home/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MicaelJarniac/paws-and-home.git"
  },
  "license": "MIT",
  "author": "Micael Jarniac",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build:client && tsx watch src/index.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "seed:images": "tsx src/scripts/copy-seed-images.ts",
    "setup": "npm run build && npm run migrate && npm run seed:images && npm run seed",
    "test": "echo \"Manual QA only\" && exit 0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.1.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

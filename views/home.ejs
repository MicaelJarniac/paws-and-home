<%- include('partials/header', {
  title: 'Paws & Home — Pet Adoption',
  description: 'Find your forever friend at Paws & Home — browse our adorable animals available for adoption.',
  currentPage: 'home'
}) %>
<%- include('partials/nav') %>
  <!-- ===== Main Content ===== -->
  <main id="main-content">

    <!-- Hero -->
    <section class="hero py-5" aria-labelledby="hero-heading">
      <div class="container text-center py-5">
        <h1 id="hero-heading" class="display-4 mb-3">Every Pet Deserves a&nbsp;Home</h1>
        <p class="lead text-muted mb-4">Browse our adorable residents and find a furry companion who's been waiting just for you.</p>
        <a href="#pets" class="btn btn-primary btn-lg">Meet Our Pets</a>
      </div>
    </section>

    <!-- Available Pets -->
    <section id="pets" class="pets-section" aria-labelledby="pets-heading">
      <h2 id="pets-heading">Available for Adoption</h2>

      <div class="row g-4" role="list">

        <!-- Pet Card 1 -->
        <article class="col-sm-6 col-lg-4" role="listitem">
          <div class="pet-card card h-100">
            <img
              src="/img/buddy.jpg"
              class="card-img-top"
              alt="Buddy, a red-and-white shepherd mix on sandy ground looking at the camera"
              loading="lazy"
            >
            <div class="pet-card-body card-body d-flex flex-column">
              <h3 class="card-title">Buddy</h3>
              <p class="pet-meta card-text">Dog · Shepherd Mix · 2 years old</p>
              <p class="card-text">Bright, alert, and full of outdoor energy. Buddy loves long walks, playtime, and staying close to his people.</p>
              <div class="mt-auto">
              <span class="badge bg-success-subtle text-success-emphasis rounded-pill mb-2">Available</span>
              <a href="/adopt?pet=Buddy&type=dog" class="btn btn-adopt">Adopt Me</a>
              </div>
            </div>
          </div>
        </article>

        <!-- Pet Card 2 -->
        <article class="col-sm-6 col-lg-4" role="listitem">
          <div class="pet-card card h-100">
            <img
              src="/img/luna.jpg"
              class="card-img-top"
              alt="Luna, a tabby cat with green eyes looking alert outdoors"
              loading="lazy"
            >
            <div class="pet-card-body card-body d-flex flex-column">
              <h3 class="card-title">Luna</h3>
              <p class="pet-meta card-text">Cat · Brown Tabby · 2 years old</p>
              <p class="card-text">Curious and confident, Luna loves to observe everything around her and is always ready for her next little adventure.</p>
              <div class="mt-auto">
              <span class="badge bg-success-subtle text-success-emphasis rounded-pill mb-2">Available</span>
              <a href="/adopt?pet=Luna&type=cat" class="btn btn-adopt">Adopt Me</a>
              </div>
            </div>
          </div>
        </article>

        <!-- Pet Card 3 -->
        <article class="col-sm-6 col-lg-4" role="listitem">
          <div class="pet-card card h-100">
            <img
              src="/img/max.jpg"
              class="card-img-top"
              alt="Max, a small black-and-tan terrier mix with upright ears"
              loading="lazy"
            >
            <div class="pet-card-body card-body d-flex flex-column">
              <h3 class="card-title">Max</h3>
              <p class="pet-meta card-text">Dog · Terrier Mix · 1 year old</p>
              <p class="card-text">Smart, watchful, and affectionate once he warms up. Max is a small companion with a big personality.</p>
              <div class="mt-auto">
              <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill mb-2">Adoption Pending</span>
              <button class="btn btn-adopt btn-disabled" disabled aria-disabled="true">Adoption Pending</button>
              </div>
            </div>
          </div>
        </article>

        <!-- Pet Card 4 -->
        <article class="col-sm-6 col-lg-4" role="listitem">
          <div class="pet-card card h-100">
            <img
              src="/img/milo.jpg"
              class="card-img-top"
              alt="Milo, a fluffy orange long-haired cat resting indoors"
              loading="lazy"
            >
            <div class="pet-card-body card-body d-flex flex-column">
              <h3 class="card-title">Milo</h3>
              <p class="pet-meta card-text">Cat · Domestic Longhair · 4 years old</p>
              <p class="card-text">Calm, regal, and very photogenic. Milo enjoys cozy indoor spots and a relaxed daily routine.</p>
              <div class="mt-auto">
              <span class="badge bg-success-subtle text-success-emphasis rounded-pill mb-2">Available</span>
              <a href="/adopt?pet=Milo&type=cat" class="btn btn-adopt">Adopt Me</a>
              </div>
            </div>
          </div>
        </article>

        <!-- Pet Card 5 -->
        <article class="col-sm-6 col-lg-4" role="listitem">
          <div class="pet-card card h-100">
            <img
              src="/img/daisy.jpg"
              class="card-img-top"
              alt="Daisy, a small fluffy white dog running joyfully across a grassy field"
              loading="lazy"
            >
            <div class="pet-card-body card-body d-flex flex-column">
              <h3 class="card-title">Daisy</h3>
              <p class="pet-meta card-text">Dog · Small Poodle Mix · 3 years old</p>
              <p class="card-text">Playful and joyful, Daisy loves running in open spaces and bringing happy energy wherever she goes.</p>
              <div class="mt-auto">
              <span class="badge bg-success-subtle text-success-emphasis rounded-pill mb-2">Available</span>
              <a href="/adopt?pet=Daisy&type=dog" class="btn btn-adopt">Adopt Me</a>
              </div>
            </div>
          </div>
        </article>

        <!-- Pet Card 6 -->
        <article class="col-sm-6 col-lg-4" role="listitem">
          <div class="pet-card card h-100">
            <img
              src="/img/cinnamon.jpg"
              class="card-img-top"
              alt="Cinnamon, a small white rabbit with upright ears on a white background"
              loading="lazy"
            >
            <div class="pet-card-body card-body d-flex flex-column">
              <h3 class="card-title">Cinnamon</h3>
              <p class="pet-meta card-text">Rabbit · Dwarf Mix · 1 year old</p>
              <p class="card-text">Soft, gentle, and curious. Cinnamon is a sweet little rabbit who enjoys calm spaces and gentle handling.</p>
              <div class="mt-auto">
              <span class="badge bg-success-subtle text-success-emphasis rounded-pill mb-2">Available</span>
              <a href="/adopt?pet=Cinnamon&type=rabbit" class="btn btn-adopt">Adopt Me</a>
              </div>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- About -->
    <section id="about" class="about-section py-5 bg-body-tertiary" aria-labelledby="about-heading">
      <div class="container" style="max-width: 720px;">
        <h2 id="about-heading" class="text-center mb-3">About Paws &amp; Home</h2>
        <p class="text-center text-muted mb-3">
          Founded in 2018, Paws &amp; Home is a no-kill shelter dedicated to rescuing,
          rehabilitating, and rehoming animals in need. Every animal in our care receives
          veterinary attention, socialization, and lots of love while waiting for their
          forever family.
        </p>
        <p class="text-center text-muted">
          We've placed over <strong>2,500 pets</strong> in loving homes and counting.
          Whether you're looking for a playful puppy or a mellow senior cat, we'll help
          you find the perfect match.
        </p>
      </div>
    </section>

    <!-- How It Works (ordered list) -->
    <section id="how-it-works" class="process-section py-5 bg-body-tertiary" aria-labelledby="process-heading">
      <div class="container" style="max-width: 620px;">
        <h2 id="process-heading" class="text-center mb-2">How It Works</h2>
        <p class="section-subtitle text-center text-muted mb-4">Bringing a new friend home is simple — just follow these steps.</p>
        <ol class="process-list list-unstyled">
          <li class="d-flex align-items-baseline gap-3 mb-3">
            <span class="process-number flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold">1</span>
            <span>Browse our available pets and find one that catches your eye</span>
          </li>
          <li class="d-flex align-items-baseline gap-3 mb-3">
            <span class="process-number flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold">2</span>
            <span>Click <strong>"Adopt Me"</strong> to start your application</span>
          </li>
          <li class="d-flex align-items-baseline gap-3 mb-3">
            <span class="process-number flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold">3</span>
            <span>Fill out the adoption form with your details and preferences</span>
          </li>
          <li class="d-flex align-items-baseline gap-3 mb-3">
            <span class="process-number flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold">4</span>
            <span>Our team reviews your application and reaches out within 48 hours</span>
          </li>
          <li class="d-flex align-items-baseline gap-3 mb-3">
            <span class="process-number flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold">5</span>
            <span>Visit the shelter to meet your match in person</span>
          </li>
          <li class="d-flex align-items-baseline gap-3 mb-3">
            <span class="process-number flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold">6</span>
            <span>Complete the adoption paperwork and take your new friend home!</span>
          </li>
        </ol>
      </div>
    </section>

    <!-- Adoption Fees (table) -->
    <section id="fees" class="fees-section py-5" aria-labelledby="fees-heading">
      <div class="container" style="max-width: 620px;">
        <h2 id="fees-heading" class="text-center mb-2">Adoption Fees</h2>
        <p class="section-subtitle text-center text-muted mb-4">All fees include essential veterinary care so your new companion is ready to go.</p>
        <div class="table-responsive">
          <table class="table table-hover">
            <caption class="visually-hidden">Adoption fees by pet type</caption>
            <thead class="table-primary">
              <tr>
                <th scope="col">Pet Type</th>
                <th scope="col">Fee</th>
                <th scope="col">Includes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Dog</td>
                <td>$150</td>
                <td>Vaccines, microchip, spay/neuter</td>
              </tr>
              <tr>
                <td>Cat</td>
                <td>$100</td>
                <td>Vaccines, microchip, spay/neuter</td>
              </tr>
              <tr>
                <td>Rabbit</td>
                <td>$50</td>
                <td>Health check, microchip</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

  </main>
<%- include('partials/footer') %>

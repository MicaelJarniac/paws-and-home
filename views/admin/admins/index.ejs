<%- include('../../partials/header', {
  title: 'Manage Admins — Paws & Home Admin',
  description: 'Manage admin accounts in the Paws & Home admin panel.',
  currentPage: 'admin-admins'
}) %>
<%- include('../../partials/admin-nav') %>

<main id="main-content">
  <section class="py-5">
    <div class="container">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Admin Accounts</h1>
        <a href="/admin/admins/new" class="btn btn-primary">+ New Admin</a>
      </div>

      <%- include('../../partials/flash') %>

      <% if (admins.length === 0) { %>
        <p class="text-muted">No admin accounts found.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-primary">
              <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Created</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% admins.forEach(admin => { %>
                <tr>
                  <td>
                    <strong><%= admin.username %></strong>
                    <% if (currentAdmin && admin.id === currentAdmin.id) { %>
                      <span class="badge bg-info-subtle text-info-emphasis rounded-pill ms-1">You</span>
                    <% } %>
                  </td>
                  <td><%= admin.email %></td>
                  <td><%= new Date(admin.createdAt).toLocaleDateString('en-US') %></td>
                  <td class="text-end">
                    <a href="/admin/admins/<%= admin.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
                    <% if (!currentAdmin || admin.id !== currentAdmin.id) { %>
                      <form action="/admin/admins/<%= admin.id %>/delete" method="post" class="d-inline" onsubmit="return confirm('Delete admin <%= admin.username %>?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include('../../partials/footer') %>

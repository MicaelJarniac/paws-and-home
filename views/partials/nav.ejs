<!-- ===== Header & Navigation ===== -->
<header class="site-header navbar navbar-expand-lg sticky-top">
  <div class="container">
    <a href="/home" class="logo navbar-brand" aria-label="Paws and Home — Home">
      🐾 Paws <span>&amp;</span> Home
    </a>

    <button
      class="nav-toggle navbar-toggler"
      id="nav-toggle"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#nav-menu"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="navbar-toggler-icon">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </span>
    </button>

    <nav class="main-nav collapse navbar-collapse" id="nav-menu" aria-label="Primary navigation">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a href="/home" class="nav-link" <%= locals.currentPage === 'home' ? 'aria-current="page"' : '' %>>Home</a></li>
        <li class="nav-item"><a href="<%= locals.currentPage === 'home' ? '#pets' : '/home#pets' %>" class="nav-link">Adopt</a></li>
        <li class="nav-item"><a href="<%= locals.currentPage === 'home' ? '#about' : '/home#about' %>" class="nav-link">About&nbsp;Us</a></li>
        <li class="nav-item"><a href="/adopt" class="nav-link" <%= locals.currentPage === 'apply' ? 'aria-current="page"' : '' %>>Apply</a></li>
        <li class="nav-item"><a href="#" class="nav-link" id="logout-link">Log&nbsp;Out</a></li>
      </ul>
      <%- include('theme') %>
    </nav>
  </div>
</header>

<%- include('partials/header', {
  title: 'Adoption Application — Paws & Home',
  description: 'Apply to adopt a pet from Paws & Home. Fill out our adoption inquiry form and we\'ll be in touch!',
  currentPage: 'apply'
}) %>
<%- include('partials/nav') %>
  <!-- ===== Main Content ===== -->
  <main id="main-content">

    <section class="form-page-section py-5" aria-labelledby="form-heading">
      <div class="container" style="max-width: 620px;">
        <h1 id="form-heading" class="text-center mb-2">Adoption Application</h1>
        <p class="form-intro text-center text-muted mb-4">Interested in giving a pet their forever home? Fill out the form below and our team will get back to you within 48 hours.</p>

        <!-- Global form feedback (success/error) -->
        <div id="form-feedback" class="alert d-none" role="alert" aria-live="assertive"></div>

        <form id="adopt-form" action="#" method="post" aria-label="Adoption application form" novalidate>

          <!-- Personal Information -->
          <fieldset class="mb-4">
            <legend class="h6 text-muted mb-3">Personal Information</legend>

            <div class="form-group mb-3">
              <label for="full-name" class="form-label">Full Name <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                type="text"
                id="full-name"
                name="full-name"
                class="form-control"
                autocomplete="name"
                required
                aria-required="true"
                aria-describedby="full-name-error"
                minlength="2"
                maxlength="100"
              >
              <span id="full-name-error" class="field-error" aria-live="polite"></span>
            </div>

            <div class="form-group mb-3">
              <label for="adopt-email" class="form-label">Email Address <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                type="email"
                id="adopt-email"
                name="email"
                class="form-control"
                autocomplete="email"
                required
                aria-required="true"
                aria-describedby="adopt-email-error"
              >
              <span id="adopt-email-error" class="field-error" aria-live="polite"></span>
            </div>

            <div class="form-group mb-3">
              <label for="phone" class="form-label">Phone Number <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="form-control"
                autocomplete="tel"
                required
                aria-required="true"
                aria-describedby="phone-error"
                placeholder="(00) 00000-0000"
                maxlength="15"
                inputmode="numeric"
              >
              <span id="phone-error" class="field-error" aria-live="polite"></span>
            </div>

            <div class="form-group mb-3">
              <label for="cpf" class="form-label">CPF <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                type="text"
                id="cpf"
                name="cpf"
                class="form-control"
                required
                aria-required="true"
                aria-describedby="cpf-error"
                placeholder="000.000.000-00"
                maxlength="14"
                inputmode="numeric"
              >
              <span id="cpf-error" class="field-error" aria-live="polite"></span>
            </div>
          </fieldset>

          <!-- Pet Preferences -->
          <fieldset class="mb-4">
            <legend class="h6 text-muted mb-3">Pet Preferences</legend>

            <div class="form-group mb-3">
              <label for="pet-type" class="form-label">Preferred Pet Type <span class="text-danger" aria-hidden="true">*</span></label>
              <select
                id="pet-type"
                name="pet-type"
                class="form-select"
                required
                aria-required="true"
                aria-describedby="pet-type-error"
              >
                <option value="">— Select —</option>
                <option value="dog">Dog</option>
                <option value="cat">Cat</option>
                <option value="rabbit">Rabbit</option>
                <option value="any">No preference</option>
              </select>
              <span id="pet-type-error" class="field-error" aria-live="polite"></span>
            </div>

            <div class="form-group mb-3">
              <label for="pet-name" class="form-label">Specific Pet (optional)</label>
              <input
                type="text"
                id="pet-name"
                name="pet-name"
                class="form-control"
                placeholder="e.g. Buddy, Luna, Cinnamon…"
              >
            </div>
          </fieldset>

          <!-- Living Situation -->
          <fieldset class="mb-4">
            <legend class="h6 text-muted mb-3">Living Situation</legend>

            <div class="form-group mb-3">
              <label for="home-type" class="form-label">Home Type <span class="text-danger" aria-hidden="true">*</span></label>
              <select
                id="home-type"
                name="home-type"
                class="form-select"
                required
                aria-required="true"
                aria-describedby="home-type-error"
              >
                <option value="">— Select —</option>
                <option value="house-yard">House with yard</option>
                <option value="house-no-yard">House without yard</option>
                <option value="apartment">Apartment</option>
                <option value="farm">Farm / rural property</option>
              </select>
              <span id="home-type-error" class="field-error" aria-live="polite"></span>
            </div>

            <div class="form-group mb-3">
              <label for="experience" class="form-label">Experience with Pets <span class="text-danger" aria-hidden="true">*</span></label>
              <select
                id="experience"
                name="experience"
                class="form-select"
                required
                aria-required="true"
                aria-describedby="experience-error"
              >
                <option value="">— Select —</option>
                <option value="first-time">First-time pet owner</option>
                <option value="some">Some experience</option>
                <option value="experienced">Experienced pet owner</option>
              </select>
              <span id="experience-error" class="field-error" aria-live="polite"></span>
            </div>
          </fieldset>

          <!-- Additional Notes -->
          <fieldset class="mb-4">
            <legend class="h6 text-muted mb-3">Additional Notes</legend>

            <div class="form-group mb-3">
              <label for="notes" class="form-label">Anything else you'd like us to know?</label>
              <textarea
                id="notes"
                name="notes"
                class="form-control"
                rows="4"
                maxlength="500"
                aria-describedby="notes-counter"
                placeholder="Tell us about your household, other pets, your schedule…"
              ></textarea>
              <span id="notes-counter" class="char-counter">0 / 500</span>
            </div>
          </fieldset>

          <button type="submit" class="btn btn-primary w-100">Submit Application</button>
        </form>
      </div>
    </section>

  </main>
<%- include('partials/footer', { additionalScripts: ['/js/validation.js'] }) %>
